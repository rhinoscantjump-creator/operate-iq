---
import type { Hub } from "../data/types";
import { funnelLabels, hubStatusLabels } from "../data/types";
import { formatSupplementLabel } from "../data/hubs";

interface Props {
  hub: Hub;
}

const { hub } = Astro.props;
const isOutline = hub.status === "outline";
const stageLabel = funnelLabels[hub.funnelStage];
const statusLabel = hubStatusLabels[hub.status];
---

{
  isOutline ? (
    <a class="hub-tile soon reveal" href={`/hubs/${hub.slug}`}>
      <span class="badge amber">
        Hub {hub.number} · {hub.operator}
      </span>
      <h3>
        {hub.titleLead} <span>{hub.titleAccent}</span>
      </h3>
      <p>{hub.outlineLeak ?? hub.leakBody}</p>
      {hub.supplementsHubIds && hub.supplementsHubIds.length > 0 && (
        <p class="supplement-line">
          Supplements {formatSupplementLabel(hub.supplementsHubIds)}
        </p>
      )}
      <div class="meta-row">
        <span class="chip">{stageLabel}</span>
        <span class="chip">{statusLabel}</span>
      </div>
    </a>
  ) : (
    <a class="hub-tile reveal" href={`/hubs/${hub.slug}`}>
      <span class="badge">
        Hub {hub.number} · {hub.operator}
      </span>
      <h3>
        {hub.titleLead} <span>{hub.titleAccent}</span>
      </h3>
      <p>{hub.leakBody}</p>
      <div class="meta-row">
        <span class="chip">{stageLabel}</span>
        <span class="chip">{statusLabel}</span>
        {hub.hireOrderFastRoi != null && (
          <span class="chip">Fast ROI #{hub.hireOrderFastRoi}</span>
        )}
      </div>
    </a>
  )
}
