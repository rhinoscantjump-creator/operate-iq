---
interface Props {
  id: string;
  title: string;
  description: string;
  topic: string;
  tools: string[];
  href: string;
}

const { id, title, description, topic, tools, href } = Astro.props;
---

<article class="card">
  <div class="card__meta">
    <span class="pill">{id}</span>
    <span class="pill">{topic.replace(/-/g, " ")}</span>
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  {
    tools.length > 0 && (
      <div class="card__meta">
        {tools.map((tool) => (
          <span class="pill">{tool}</span>
        ))}
      </div>
    )
  }
</article>
