---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import { product } from "../data/hubs";

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description = product.positioning, path = "" } = Astro.props;
const fullTitle = title === product.name ? title : `${title} · ${product.name}`;
const canonical = new URL(path || "/", Astro.site).href;

function navClass(href: string) {
  const current = Astro.url.pathname;
  if (href === "/") return current === "/" ? "active" : "";
  return current.startsWith(href) ? "active" : "";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <Analytics />
  </head>
  <body>
    <div class="app-shell">
      <header class="site-nav">
        <a class="brand" href="/">
          <div class="brand-name">
            Operate <span>IQ</span>
          </div>
          <div class="brand-sub">{product.naming.unit} OS for local services</div>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/" class={navClass("/")}>Home</a>
          <a href="/leak-map" class={navClass("/leak-map")}>Leak map</a>
          <a href="/dashboard" class={navClass("/dashboard")}>Owner score</a>
          <a href="/hubs/database-reactivation" class={navClass("/hubs")}>Hubs</a>
          <a href="/dashboard" class="btn btn-primary nav-cta">Leak score</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <span>{product.name} — {product.tagline}</span>
        <span>Hubs · Operators · measurable leaks</span>
      </footer>
    </div>
  </body>
</html>
