---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import { product } from "../data/hubs";

interface Props {
  title: string;
  description?: string;
  path?: string;
  /** Page-specific schema.org objects rendered alongside the site Organization */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = product.positioning, path = "", jsonLd = [] } = Astro.props;
const fullTitle = title === product.name ? title : `${title} · ${product.name}`;
const canonical = new URL(path || "/", Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;

const organization = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: product.name,
  url: siteUrl,
  description: product.positioning,
  creator: {
    "@type": "Organization",
    name: product.author.brand,
    url: product.author.url,
  },
};

function navClass(href: string) {
  const current = Astro.url.pathname;
  if (href === "/") return current === "/" ? "active" : "";
  return current.startsWith(href) ? "active" : "";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />
    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <Analytics />
  </head>
  <body>
    <div class="app-shell">
      <header class="site-nav">
        <a class="brand" href="/">
          <div class="brand-name">
            Operate <span>IQ</span>
          </div>
          <div class="brand-sub">{product.naming.unit} OS for local services</div>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/" class={navClass("/")}>Home</a>
          <a href="/hubs" class={navClass("/hubs")}>Hubs</a>
          <a href="/leak-map" class={navClass("/leak-map")}>Leak map</a>
          <a href="/dashboard" class={navClass("/dashboard")}>Owner score</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <span>{product.name} — a published reference architecture, not a product on sale.</span>
        <span>
          Built by{" "}
          <a href={product.author.url} rel="noopener">{product.author.brand}</a>
        </span>
      </footer>
    </div>
  </body>
</html>
