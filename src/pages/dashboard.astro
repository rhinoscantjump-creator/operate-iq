---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  documentedHubs,
  overallLeakScore,
  product,
  sampleLeakScores,
} from "../data/hubs";

const overall = overallLeakScore();
const weakest = [...sampleLeakScores].sort((a, b) => a.score - b.score)[0];
const weakestHub = documentedHubs.find((h) => h.id === weakest.hubId);
---

<BaseLayout title="Hub 11 wireframe — the owner leak score" path="/dashboard">
  <section class="hero hero-animate">
    <div class="hero-kicker">Wireframe · Hub 11</div>
    <h1>
      One <em>leak score</em>
    </h1>
    <p class="hero-lead">
      Hub 11 was designed around a single cross-hub number: one screen that ranks every leak and
      tells the owner which to plug first. This page draws that screen so the playbook has
      something to point at. It is a picture, not a dashboard — every figure on it was made up.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/hubs">Read the hubs →</a>
      <a class="btn btn-ghost" href="/leak-map">See the leak map</a>
    </div>
  </section>

  <section class="section reveal">
    <div class="panel coming-soon-panel">
      <span class="badge amber">Invented numbers</span>
      <h2 class="panel-title" style="font-size: clamp(1.35rem, 2.5vw, 1.75rem); margin-top: 0.85rem">
        Nothing here was ever measured
      </h2>
      <p style="color: var(--muted); margin: 0">
        {product.name} is a reference architecture, so this surface was never built and never
        connected to a CRM, phone system, or calendar. The scores, bars, and trend arrows below
        are illustrative — they exist to show the shape the screen would take, and the reasoning
        behind ranking leaks this way. Read them as a sketch on paper.
      </p>
    </div>
  </section>

  <section class="section reveal">
    <div class="section-head">
      <div>
        <h2>The composite score</h2>
        <p>Illustrative figures, drawn to show the layout Hub 11 describes.</p>
      </div>
    </div>
    <div class="panel leak-score-hero">
      <div
        class="score-ring"
        style={`--p: ${overall * 3.6}deg`}
        aria-label={`Overall leak score ${overall}`}
      >
        {overall}
      </div>
      <div>
        <span class="badge">Composite leak score</span>
        <h3 style="font-family: var(--font-display); margin: 0.6rem 0 0.4rem">
          Higher is healthier
        </h3>
        <p style="margin: 0; color: var(--muted)">
          An average across the hub scores. The design principle behind it: go at the weakest hub
          first — usually capture, meaning missed calls and speed-to-lead — before buying more ads.
        </p>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="section-head">
      <div>
        <h2>Hub scores</h2>
        <p>Each row maps to the KPI set documented in that hub's playbook.</p>
      </div>
    </div>
    <div class="panel score-table">
      {
        sampleLeakScores.map((row) => {
          const hub = documentedHubs.find((h) => h.id === row.hubId);
          if (!hub) return null;
          const trendLabel =
            row.trend === "up"
              ? "↑ improving"
              : row.trend === "down"
                ? "↓ worsening"
                : "→ flat";
          const trendClass = `trend-${row.trend}`;
          return (
            <div class="score-row">
              <div>
                <strong>
                  Hub {hub.number} · {hub.titleLead} {hub.titleAccent}
                </strong>
                <div style="color: var(--muted); font-size: 0.9rem">{row.note}</div>
              </div>
              <div class="bar" aria-hidden="true">
                <span style={`width: ${row.score}%`} />
              </div>
              <div style="text-align: right">
                <div style="font-family: var(--font-display); font-size: 1.3rem">
                  {row.score}
                </div>
                <div class={trendClass}>{trendLabel}</div>
                <a href={`/hubs/${hub.slug}`} style="color: var(--teal); font-size: 0.85rem">
                  Open hub
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  {
    weakestHub && (
      <section class="section reveal">
        <div class="section-head">
          <div>
            <h2>Recommended focus</h2>
            <p>Weakest hub first — the triage rule Hub 11 was designed to apply.</p>
          </div>
        </div>
        <div class="panel">
          <span class="badge amber">Start here</span>
          <h3 style="font-family: var(--font-display); margin: 0.75rem 0 0.4rem">
            Hub {weakestHub.number} · {weakestHub.titleLead} {weakestHub.titleAccent}
          </h3>
          <p style="color: var(--muted); margin-top: 0">{weakest.note}</p>
          <a class="btn btn-primary" href={`/hubs/${weakestHub.slug}`} style="margin-top: 1rem">
            Read this hub →
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
