---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerticalPack from "../../components/VerticalPack.astro";
import { funnelLabels, hubStatusLabels } from "../../data/types";
import { getCompanionsForHub } from "../../data/companions";
import {
  formatSupplementLabel,
  getCompliance,
  getHubBySlug,
  getIntegration,
  getSupplementingHubs,
  hubs,
} from "../../data/hubs";

export function getStaticPaths() {
  return hubs.map((hub) => ({ params: { slug: hub.slug } }));
}

const { slug } = Astro.params;
const hub = getHubBySlug(slug!);

if (!hub) {
  return Astro.redirect("/hubs");
}

const isDocumented = hub.status === "documented";
const supplementing = getSupplementingHubs(hub.id);
const companions = getCompanionsForHub(hub.id);
const allSorted = [...hubs].sort((a, b) => a.number.localeCompare(b.number));
const allIdx = allSorted.findIndex((h) => h.id === hub.id);
const prevHub = allIdx > 0 ? allSorted[allIdx - 1] : undefined;
const nextHub = allIdx >= 0 && allIdx < allSorted.length - 1 ? allSorted[allIdx + 1] : undefined;
const pageTitle = `${hub.titleLead} ${hub.titleAccent}`;
const dive = hub.deepDive;
const description = dive?.symptom ?? hub.outlineLeak ?? hub.leakBody;
const hubUrl = new URL(`/hubs/${hub.slug}`, Astro.site).href;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Hubs", item: new URL("/hubs", Astro.site).href },
    { "@type": "ListItem", position: 3, name: `Hub ${hub.number} · ${pageTitle}`, item: hubUrl },
  ],
};

const howTo =
  isDocumented && dive
    ? {
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: `How to plug the ${pageTitle.toLowerCase()} leak`,
        description: dive.symptom,
        url: hubUrl,
        totalTime: "P7D",
        step: dive.steps.map((text, i) => ({
          "@type": "HowToStep",
          position: i + 1,
          name: text.split(/[.:]/)[0],
          text,
        })),
      }
    : null;

const jsonLd = [breadcrumb, ...(howTo ? [howTo] : [])];
---

<BaseLayout
  title={pageTitle}
  description={description}
  path={`/hubs/${hub.slug}`}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/hubs">Hubs</a>
    <span>/</span>
    <span>Hub {hub.number}</span>
  </nav>

  <section class="hub-hero">
    <span class:list={["badge", { amber: !isDocumented }]}>
      Hub {hub.number} · {hub.operator}
    </span>
    <h1 class="hub-title">
      {hub.titleLead} <span>{hub.titleAccent}</span>
    </h1>
    <p class="hub-lead">{hub.outlineLeak ?? hub.leakBody}</p>
    <div class="meta-row">
      <span class="chip">{funnelLabels[hub.funnelStage]}</span>
      <span class="chip">{hubStatusLabels[hub.status]}</span>
      <span class="chip">Logical hire #{hub.hireOrderLogical}</span>
      {
        hub.hireOrderFastRoi != null && (
          <span class="chip">Fast ROI #{hub.hireOrderFastRoi}</span>
        )
      }
    </div>

    {
      isDocumented && dive && (
        <dl class="playbook-meta">
          <div class="meta-block">
            <dt>Symptom</dt>
            <dd>{dive.symptom}</dd>
          </div>
          <div class="meta-block">
            <dt>Who this is for</dt>
            <dd>{dive.audience}</dd>
          </div>
          <div class="meta-block">
            <dt>Time / margin leak</dt>
            <dd>{dive.timeLeak}</dd>
          </div>
          <div class="meta-block">
            <dt>Guardrail</dt>
            <dd>{dive.guardrail}</dd>
          </div>
        </dl>
      )
    }

    <div class="hub-layout">
      <div class="leak-box">
        <div class="leak-label">The leak</div>
        <div class="leak-stat">{hub.leakStat}</div>
        <p style="margin: 0; color: var(--muted)">{hub.punchline}</p>
      </div>
      <div class="diagram" aria-label="Hub diagram">
        {hub.diagramLabel}
      </div>
    </div>
  </section>

  {
    !isDocumented && (
      <>
        <section class="section">
          <div class="guardrail-callout">
            <h3>Outline only</h3>
            <p>
              This hub was scoped but never written past the leak statement — no steps, KPIs, or
              guardrails. The hubs it would extend are listed below, and those do have full
              playbooks.
            </p>
          </div>
        </section>
        {
          hub.supplementsHubIds && hub.supplementsHubIds.length > 0 && (
            <section class="section">
              <div class="section-head">
                <div>
                  <h2>Builds on</h2>
                  <p>Hubs this one builds on — those have full playbooks.</p>
                </div>
              </div>
              <div class="related-grid">
                {
                  hub.supplementsHubIds.map((id) => {
                    const parent = hubs.find((h) => h.id === id);
                    if (!parent) return null;
                    return (
                      <a class="related-card hub-index-link-card" href={`/hubs/${parent.slug}`}>
                        <h4>
                          Hub {parent.number} · {parent.titleLead} {parent.titleAccent}
                        </h4>
                        <p>{parent.leakBody}</p>
                      </a>
                    );
                  })
                }
              </div>
            </section>
          )
        }
        {
          hub.integrations.length > 0 && (
            <section class="section">
              <div class="section-head">
                <div>
                  <h2>Planned integrations</h2>
                  <p>Connections this hub would need to work.</p>
                </div>
              </div>
              <div class="integration-grid">
                {
                  hub.integrations.map((id) => {
                    const item = getIntegration(id);
                    if (!item) return null;
                    return (
                      <div class="integration-card">
                        <h4>{item.label}</h4>
                        <p>{item.purpose}</p>
                      </div>
                    );
                  })
                }
              </div>
            </section>
          )
        }
      </>
    )
  }

  {
    isDocumented && dive && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Before → after</h2>
            <p>What would change if this operator were running.</p>
          </div>
        </div>
        <div class="before-after">
          <div class="panel">
            <h3>Before</h3>
            <p>{dive.before}</p>
          </div>
          <div class="panel">
            <h3>After</h3>
            <p>{dive.after}</p>
          </div>
        </div>
      </section>
    )
  }

  {
    isDocumented && dive && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Steps to implement</h2>
            <p>Copyable operating order — connect, pilot, measure, then scale.</p>
          </div>
        </div>
        <ol class="step-list">
          {dive.steps.map((step) => (
            <li>
              <p>{step}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    isDocumented && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>What this operator does</h2>
        <p>The capabilities this operator was specced to have.</p>
      </div>
    </div>
    <ul class="capability-list">
      {
        hub.capabilities.map((cap, i) => (
          <li>
            <span class="arrow">{i + 1}</span>
            <div>
              <h4>{cap.title}</h4>
              <p>{cap.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="punchline">{hub.punchline}</div>
      </section>
    )
  }

  {
    isDocumented && dive && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Failure modes</h2>
            <p>Where this hub breaks if you skip the guardrails.</p>
          </div>
        </div>
        <ul class="failure-list">
          {dive.failureModes.map((mode) => (
            <li>
              <strong>{mode.title}</strong>
              <p>{mode.detail}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    isDocumented && dive && (
      <section class="section">
        <div class="guardrail-callout">
          <h3>When not to automate</h3>
          <p>{dive.whenNotToAutomate}</p>
        </div>
      </section>
    )
  }

  {
    isDocumented && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>KPIs</h2>
        <p>Measurable outcomes the owner brief (Hub 11) was designed to track for this hub.</p>
      </div>
    </div>
    <div class="kpi-grid">
      {
        hub.kpis.map((kpi) => (
          <div class="kpi-card">
            <h4>{kpi.label}</h4>
            <p>{kpi.description}</p>
            <p class="target-hint">{kpi.targetHint}</p>
          </div>
        ))
      }
    </div>
      </section>
    )
  }

  {
    isDocumented && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Vertical pack</h2>
        <p>Neutral SMB default, with pack-specific offer and tone notes.</p>
      </div>
    </div>
    <VerticalPack notes={hub.verticalNotes} />
      </section>
    )
  }

  {
    isDocumented && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Integrations</h2>
        <p>Without these connections, the hub is a slide — not a product.</p>
      </div>
    </div>
    <div class="integration-grid">
      {
        hub.integrations.map((id) => {
          const item = getIntegration(id);
          if (!item) return null;
          return (
            <div class="integration-card">
              <h4>{item.label}</h4>
              <p>{item.purpose}</p>
            </div>
          );
        })
      }
    </div>
      </section>
    )
  }

  {
    isDocumented && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Compliance</h2>
        <p>Built-in guardrails: consent, incentives, handoff, and data minimization.</p>
      </div>
    </div>
    <div class="compliance-grid">
      {
        hub.complianceIds.map((id) => {
          const rule = getCompliance(id);
          if (!rule) return null;
          return (
            <div class="compliance-card">
              <h4>{rule.title}</h4>
              <p>{rule.detail}</p>
            </div>
          );
        })
      }
    </div>
      </section>
    )
  }

  {
    isDocumented && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Shipped improvements</h2>
        <p>Content and product upgrades encoded in this hub.</p>
      </div>
    </div>
    <div class="improve-grid">
      {
        hub.productImprovements.map((item) => (
          <div class="improve-card">
            <h4>{item}</h4>
          </div>
        ))
      }
    </div>
      </section>
    )
  }

  {
    isDocumented && supplementing.length > 0 && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>Extended by</h2>
            <p>Hubs that protect or extend this operator’s ROI — open the related deep dive.</p>
          </div>
        </div>
        <div class="related-grid">
          {
            supplementing.map((addon) => (
              <a class="related-card hub-index-link-card" href={`/hubs/${addon.slug}`}>
                <h4>
                  Hub {addon.number} · {addon.titleLead} {addon.titleAccent}
                </h4>
                <p>{addon.supplementsWhy ?? addon.outlineLeak}</p>
                <p class="supplement-line" style="margin-top: 0.5rem">
                  Supplements {formatSupplementLabel(addon.supplementsHubIds ?? [])}
                </p>
              </a>
            ))
          }
        </div>
      </section>
    )
  }

  {
    isDocumented && companions.length > 0 && (
      <section class="section">
        <div class="section-head">
          <div>
            <h2>After this leak is plugged</h2>
            <p>Companions — payoff guidance, not Operator skill.</p>
          </div>
        </div>
        {
          companions.map((c) => (
            <div class="panel companion-callout">
              <span class="badge amber">{c.kicker}</span>
              <h3 style="font-family: var(--font-display); margin: 0.75rem 0 0.4rem">
                {c.titleLead} {c.titleAccent}
              </h3>
              <p style="color: var(--muted); margin: 0">
                Once this leak is plugged, paid ads stop funding a broken handoff — the same Google
                and Meta spend books more.
              </p>
              <a class="btn btn-ghost" href={`/hubs/${c.slug}`} style="margin-top: 1rem">
                Open {c.titleLead} {c.titleAccent} →
              </a>
            </div>
          ))
        }
      </section>
    )
  }

  <section class="section">
    <div class="hero-actions">
      {
        prevHub ? (
          <a class="btn btn-ghost" href={`/hubs/${prevHub.slug}`}>
            ← Hub {prevHub.number}
          </a>
        ) : (
          <a class="btn btn-ghost" href="/hubs">← All hubs</a>
        )
      }
      {
        nextHub ? (
          <a class="btn btn-primary" href={`/hubs/${nextHub.slug}`}>
            Hub {nextHub.number} →
          </a>
        ) : (
          <a class="btn btn-primary" href="/leak-map">Leak map →</a>
        )
      }
    </div>
  </section>
</BaseLayout>
