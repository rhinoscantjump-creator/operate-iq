---
import BaseLayout from "../layouts/BaseLayout.astro";
import { product } from "../data/hubs";

const sent = Astro.url.searchParams.get("sent") === "1";
const siteOrigin = Astro.site?.origin ?? "https://operate-iq.com";
const nextUrl = `${siteOrigin}/contact?sent=1`;
---

<BaseLayout
  title="Get in touch"
  description="Tell us where you're leaking — we'll help you take the first steps to plug and optimize."
  path="/contact"
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span>/</span>
    <span>Contact</span>
  </nav>

  <section class="hero">
    <div class="hero-kicker">First steps</div>
    <h1>Let's plug your <em>leaks</em></h1>
    <p class="hero-lead">
      The owner score dashboard is coming soon. Until then, tell us where you're leaking and
      we'll guide you on the first hubs to hire — no pitch deck required.
    </p>
  </section>

  {
    sent ? (
      <section class="section">
        <div class="panel contact-success" role="status">
          <span class="badge ok">Message sent</span>
          <h2 style="font-family: var(--font-display); margin: 0.75rem 0 0.4rem">
            Thanks — we'll be in touch
          </h2>
          <p style="color: var(--muted); margin: 0">
            Dean will follow up at the email you provided. Prefer to reach out directly?{" "}
            <a href={`mailto:${product.contact.email}`} style="color: var(--teal)">
              {product.contact.email}
            </a>
          </p>
          <a class="btn btn-ghost" href="/hubs" style="margin-top: 1.25rem">
            Browse the hubs →
          </a>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="contact-layout">
          <div class="panel contact-aside">
            <span class="badge amber">Coming soon</span>
            <h2 class="panel-title">Owner leak score</h2>
            <p style="color: var(--muted); margin: 0 0 1rem">
              We're building a single score that ranks every hub leak — your morning brief when
              Hub 11 goes live. Until then, leave your details and we'll help you prioritize
              what to plug first.
            </p>
            <ul class="contact-points">
              <li>Which hub to hire first for your vertical</li>
              <li>What to connect before you automate</li>
              <li>How to pilot without burning the list</li>
            </ul>
            <p class="contact-direct">
              Questions now?{" "}
              <a href={`mailto:${product.contact.email}`}>{product.contact.email}</a>
            </p>
          </div>

          <form
            class="panel contact-form"
            action={product.contact.formAction}
            method="POST"
          >
            <input type="hidden" name="_subject" value="Operate IQ — new contact" />
            <input type="hidden" name="_next" value={nextUrl} />
            <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="_template" value="table" />

            <h2 class="panel-title">Contact sheet</h2>
            <p class="form-lead">We'll reach out — you don't need to chase us.</p>

            <div class="form-grid">
              <label class="form-field">
                <span>Name</span>
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label class="form-field">
                <span>Email</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
              <label class="form-field">
                <span>Business name</span>
                <input type="text" name="business" autocomplete="organization" />
              </label>
              <label class="form-field">
                <span>Vertical</span>
                <select name="vertical" required>
                  <option value="">Select…</option>
                  <option value="Gym">Gym</option>
                  <option value="Clinic">Clinic</option>
                  <option value="Home services">Home services</option>
                  <option value="Salon">Salon</option>
                  <option value="General SMB">General SMB</option>
                  <option value="Other">Other</option>
                </select>
              </label>
              <label class="form-field form-field-full">
                <span>Biggest leak right now</span>
                <select name="biggest_leak">
                  <option value="">Not sure yet</option>
                  <option value="Old leads / database">Old leads / database</option>
                  <option value="Reviews & referrals">Reviews &amp; referrals</option>
                  <option value="Website / form speed">Website / form speed</option>
                  <option value="Missed calls">Missed calls</option>
                  <option value="Sales follow-up">Sales follow-up</option>
                  <option value="Other">Other</option>
                </select>
              </label>
              <label class="form-field form-field-full">
                <span>Anything else we should know?</span>
                <textarea
                  name="message"
                  rows="4"
                  placeholder="Tools you use, team size, what you've already tried…"
                ></textarea>
              </label>
            </div>

            <button class="btn btn-primary" type="submit">Send — we'll contact you</button>
          </form>
        </div>
      </section>
    )
  }
</BaseLayout>
