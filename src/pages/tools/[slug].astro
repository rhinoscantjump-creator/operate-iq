---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaybookCard from "../../components/PlaybookCard.astro";
import { getCollection } from "astro:content";
import { toolLabels, tools, type ToolSlug } from "../../data/site";

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool } }));
}

const { slug } = Astro.params as { slug: ToolSlug };
const label = toolLabels[slug];

const playbooks = (await getCollection("playbooks"))
  .filter((p) => !p.data.draft && p.data.tools.includes(slug))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<BaseLayout
  title={`${label} playbooks`}
  description={`Operational playbooks involving ${label} for accounting firms.`}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/tools">Tools</a> / {label}
    </nav>

    <header class="page-header">
      <h1>{label} playbooks</h1>
      <p>Workflow fixes that mention {label} in the stack.</p>
    </header>

    {
      playbooks.length > 0 ? (
        <div class="grid grid--2">
          {playbooks.map((playbook) => (
            <PlaybookCard
              id={playbook.data.id}
              title={playbook.data.title}
              description={playbook.data.description}
              topic={playbook.data.topic}
              tools={playbook.data.tools}
              href={`/playbooks/${playbook.id}`}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No playbooks for {label} yet.</p>
      )
    }
  </div>
</BaseLayout>
