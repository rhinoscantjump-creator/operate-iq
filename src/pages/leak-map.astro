---
import BaseLayout from "../layouts/BaseLayout.astro";
import HubTile from "../components/HubTile.astro";
import { funnelLabels, funnelOrder } from "../data/types";
import {
  outlineHubs,
  fastRoiHireOrder,
  hubsByFunnel,
  documentedHubs,
  logicalHireOrder,
  overallLeakScore,
  product,
  recommendedNextHubs,
  sampleLeakScores,
  statSources,
  getHubById,
} from "../data/hubs";

const overall = overallLeakScore();
const miniScores = [...sampleLeakScores]
  .sort((a, b) => a.score - b.score)
  .slice(0, 3);
---

<BaseLayout
  title="Leak map"
  description="How Operate IQ's 13 hubs fit together — hire paths, add-ons, and the OS map."
  path="/leak-map"
>
  <section class="hero">
    <div class="hero-kicker">Operating system map</div>
    <h1>Leak <em>map</em></h1>
    <p class="hero-lead">
      <strong>13 operators. One OS.</strong> The documented hubs cover the biggest local-service
      leaks; the outline hubs would extend capture, conversion, and the owner brief.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#hire-order">See the hire order</a>
      <a class="btn btn-ghost" href="/hubs">Browse all 13 hubs</a>
    </div>
  </section>

  <section class="section" id="leak-score">
    <div class="section-head">
      <div>
        <h2>One score. Every leak ranked.</h2>
        <p>
          How Hub 11 was designed to rank the leaks. The numbers are invented — nothing here was
          measured.{" "}
          <a href="/dashboard" style="color: var(--teal)">See the full wireframe →</a>
        </p>
      </div>
    </div>
    <div class="panel leak-score-hero">
      <div
        class="score-ring"
        style={`--p: ${overall * 3.6}deg`}
        aria-label={`Overall leak score ${overall}`}
      >
        {overall}
      </div>
      <div class="score-table mini-score-table">
        {
          miniScores.map((row) => {
            const hub = documentedHubs.find((h) => h.id === row.hubId);
            if (!hub) return null;
            const trendClass = `trend-${row.trend}`;
            const trendLabel =
              row.trend === "up"
                ? "↑ improving"
                : row.trend === "down"
                  ? "↓ worsening"
                  : "→ flat";
            return (
              <div class="score-row">
                <div>
                  <strong>
                    Hub {hub.number} · {hub.titleLead} {hub.titleAccent}
                  </strong>
                  <div style="color: var(--muted); font-size: 0.9rem">{row.note}</div>
                </div>
                <div class="bar" aria-hidden="true">
                  <span style={`width: ${row.score}%`} />
                </div>
                <div style="text-align: right">
                  <div style="font-family: var(--font-display); font-size: 1.3rem">
                    {row.score}
                  </div>
                  <div class={trendClass}>{trendLabel}</div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section" id="map">
    <div class="section-head">
      <div>
        <h2>Funnel stages</h2>
        <p>
          Logical flow: Capture → Reactivate → Reputation → Convert → Insight. The homepage browse
          order leads with Reactivate for cash-first owners.{" "}
          <a href="/hubs" style="color: var(--teal)">Open the full hub directory →</a>
        </p>
      </div>
    </div>
    <div class="stage-grid">
      {
        funnelOrder.map((stage) => {
          const stageHubs = hubsByFunnel(stage);
          if (!stageHubs.length) return null;
          return (
            <div class="panel stage-card">
              <span class="badge">{funnelLabels[stage]}</span>
              <ul class="stage-list">
                {stageHubs.map((hub) => (
                  <li>
                    <a href={`/hubs/${hub.slug}`}>
                      <strong>
                        {hub.number} · {hub.titleLead} {hub.titleAccent}
                      </strong>
                    </a>
                    <span class="stage-note">{hub.punchline}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="section" id="hire-order">
    <div class="section-head">
      <div>
        <h2>Two hire paths</h2>
        <p>
          Logical operating order follows the funnel. Fastest ROI order leads with Database
          Reactivation when the CRM is already full of dust.
        </p>
      </div>
    </div>
    <div class="order-grid">
      <div class="panel">
        <span class="badge">Logical funnel</span>
        <h3 class="panel-title">Capture → Protect → Reactivate → Reputation → Convert → Insight</h3>
        <ol class="order-list">
          {
            logicalHireOrder.map((hub, index) => (
              <li>
                <span class="order-num">{index + 1}</span>
                <div>
                  <strong>
                    Hub {hub.number} · {hub.titleLead} {hub.titleAccent}
                  </strong>
                  <div class="meta-row" style="margin-top: 0.35rem">
                    <span class="chip">{funnelLabels[hub.funnelStage]}</span>
                    <span class="chip">{hub.operator}</span>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="panel">
        <span class="badge amber">Fastest ROI</span>
        <h3 class="panel-title">Cash-first when the database is full</h3>
        <ol class="order-list">
          {
            fastRoiHireOrder.map((hub, index) => (
              <li>
                <span class="order-num">{index + 1}</span>
                <div>
                  <strong>
                    Hub {hub.number} · {hub.titleLead} {hub.titleAccent}
                  </strong>
                  <div class="meta-row" style="margin-top: 0.35rem">
                    <span class="chip">ROI path #{hub.hireOrderFastRoi}</span>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>How the add-ons sit on the documented hubs</h2>
        <p>Supplement relationships — what each outline hub was designed to extend.</p>
      </div>
    </div>
    <div class="os-map">{`04/03 capture ──► 08 omnichannel inbox
       │
       ├──► 06 no-show recovery
       └──► 07 quote follow-up ──► 05 sales coaching ──► 13 staff onboarding

01 dusty leads (never converted)
09 churned customers (were paying)     both feed revenue without ads
12 collections (after the sale)

02 ask for reviews/referrals
10 defend/reply to reputation damage

11 owner brief  ◄── scores all of the above

plugged leaks ──► ad spend converts better (companion)`}</div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Add-on hubs (outline only)</h2>
        <p>
          Scoped but never written up. Next three worth writing:{" "}
          {
            recommendedNextHubs
              .map((id) => {
                const h = getHubById(id);
                return h ? `Hub ${h.number}` : id;
              })
              .join(", ")
          }
        </p>
      </div>
    </div>
    <div class="hub-grid">
      {outlineHubs.map((hub) => <HubTile hub={hub} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Then ads work harder</h2>
        <p>
          Once Reactivate, Reputation, and Capture stop wasting the click, the same Google and Meta
          spend converts better — a companion payoff, not another Operator.
        </p>
      </div>
    </div>
    <div class="panel companion-callout">
      <span class="badge amber">Companion · not an Operator</span>
      <h3 style="font-family: var(--font-display); margin: 0.75rem 0 0.4rem">
        Ad Multiplier
      </h3>
      <p style="color: var(--muted); margin: 0">
        Plug the leaks first. Scale ads when the handoff is healthy — not to paper over dust, missed
        calls, and slow replies. No invented ROAS percentage; the lift is fewer wasted clicks.
      </p>
      <a class="btn btn-primary" href="/hubs/ad-multiplier" style="margin-top: 1.15rem">
        Open Ad Multiplier →
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>What Operate IQ is not</h2>
        <p>Named anti-patterns — the guardrails behind every hub.</p>
      </div>
    </div>
    <div class="anti-grid">
      <div class="panel anti-card">
        <h3 class="panel-title">Tool soup</h3>
        <p>Five disconnected apps with no leak score. Nobody knows what to fix first.</p>
      </div>
      <div class="panel anti-card">
        <h3 class="panel-title">Magic AI</h3>
        <p>
          Automation with no human handoff on money, health, or reputation. One bad send erases
          trust.
        </p>
      </div>
      <div class="panel anti-card">
        <h3 class="panel-title">Ad treadmill</h3>
        <p>Buying strangers while the CRM gathers dust. The fastest ROI path starts inside the list.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Stat discipline</h2>
        <p>
          Headline numbers are treated as citeable claims — not decoration. Replace placeholders
          with the latest published survey year before public launch.
        </p>
      </div>
    </div>
    <div class="panel">
      <ul class="sources">
        {
          statSources.map((s) => (
            <li>
              <strong>{s.claim}</strong>
              <br />
              Source: {s.source}
              {
                s.note && (
                  <>
                    <br />
                    Note: {s.note}
                  </>
                )
              }
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
