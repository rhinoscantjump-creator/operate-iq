---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="That page doesn't exist — today's puzzles are still on the home page."
  path="/404"
>
  <section class="hero hero-animate">
    <div class="hero-kicker">404</div>
    <h1>Nothing to <em>solve</em> here</h1>
    <p class="hero-lead">
      That URL isn't a puzzle. Today's wordsearch and sudoku are still waiting on the home page.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-ghost" href="/wordsearch">Wordsearch</a>
      <a class="btn btn-ghost" href="/sudoku">Sudoku</a>
    </div>
  </section>
</BaseLayout>
