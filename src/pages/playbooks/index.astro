---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaybookCard from "../../components/PlaybookCard.astro";
import { getCollection } from "astro:content";
import { topics } from "../data/site";

const playbooks = (await getCollection("playbooks"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.id.localeCompare(b.data.id));
---

<BaseLayout title="Playbooks" description="Tool-specific operational playbooks for accounting firms.">
  <div class="container">
    <header class="page-header">
      <h1>Playbooks</h1>
      <p>
        Short, actionable fixes — symptom headline, before/after map, steps, and
        human-in-the-loop guardrails.
      </p>
    </header>

    <div class="grid grid--2">
      {
        playbooks.map((playbook) => (
          <PlaybookCard
            id={playbook.data.id}
            title={playbook.data.title}
            description={playbook.data.description}
            topic={playbook.data.topic}
            tools={playbook.data.tools}
            href={`/playbooks/${playbook.id}`}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
