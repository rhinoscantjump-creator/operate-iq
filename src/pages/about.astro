---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="About" description={`About ${site.name} — operational playbooks for accounting firms.`}>
  <div class="container">
    <header class="page-header">
      <h1>About {site.name}</h1>
      <p>
        We document how boutique accounting and bookkeeping firms fix operational
        bottlenecks — with tool-specific playbooks, guardrails, and before/after
        workflow maps.
      </p>
    </header>

    <div class="prose">
      <h2>What this site is</h2>
      <p>
        A public ops library — not a sales pitch. Each playbook answers a specific
        symptom search ("how do I get Gmail receipts into QuickBooks?") with
        practical steps and human-in-the-loop safety patterns.
      </p>

      <h2>Who it is for</h2>
      <p>
        Firm owners, bookkeepers, and ops-minded accountants at boutique practices
        who charge by the hour and feel manual data movement as real margin loss.
      </p>

      <h2>What we are not (yet)</h2>
      <p>
        No paid audits, toolkits, or implementation services on this site today.
        Those may come later as optional layers — the library comes first.
      </p>

      <div class="callout">
        <strong>Built for search and AI answer engines</strong>
        <p>
          Pages are structured so humans and agents can quote them: symptom → leak →
          steps → guardrail → related fixes.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
