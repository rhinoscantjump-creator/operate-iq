---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={site.name} path="/">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-animate">
        <div class="hero-kicker">Daily · UTC midnight</div>
        <h1>Operate <em>IQ</em></h1>
        <p class="hero-lead">{site.tagline}</p>
        <p class="hero-audience">
          A wordsearch, a sudoku, and WordGuess, shared with everyone on the same calendar day. Progress stays on this device.
        </p>
        <div class="daily-meta" aria-live="polite">
          <div>
            <span class="meta-label">Today</span>
            <strong id="daily-date">Loading date…</strong>
          </div>
          <div>
            <span class="meta-label">New puzzles in</span>
            <strong id="daily-countdown">—</strong>
          </div>
        </div>
      </div>

      <nav class="desk-launch" aria-label="Open today's puzzles">
        <a class="desk-btn" href="/wordsearch" data-puzzle-card="wordsearch">
          <span class="desk-btn-name">Wordsearch</span>
          <span class="desk-btn-streak" id="streak-wordsearch">0</span>
          <span class="desk-btn-status" data-card-status>Open</span>
        </a>
        <a class="desk-btn" href="/sudoku" data-puzzle-card="sudoku">
          <span class="desk-btn-name">Sudoku</span>
          <span class="desk-btn-streak" id="streak-sudoku">0</span>
          <span class="desk-btn-status" data-card-status>Open</span>
        </a>
        <a class="desk-btn" href="/wordguess" data-puzzle-card="wordguess">
          <span class="desk-btn-name">WordGuess</span>
          <span class="desk-btn-streak" id="streak-wordguess">0</span>
          <span class="desk-btn-status" data-card-status>Open</span>
        </a>
        <span class="desk-btn is-soon" aria-disabled="true">
          <span class="desk-btn-name">Coming next</span>
          <span class="desk-btn-streak" aria-hidden="true">—</span>
          <span class="desk-btn-status">Soon</span>
        </span>
      </nav>
    </div>
  </section>

  <section class="section reveal-stagger" aria-label="Today's puzzles">
    <div class="puzzle-card-grid">
      <a class="puzzle-card reveal" href="/wordsearch" data-puzzle-card="wordsearch">
        <div class="card-top">
          <span class="badge">Wordsearch</span>
          <span class="card-status" data-card-status>Open</span>
        </div>
        <h2>Find the hidden list</h2>
        <p>A 12×12 grid with a daily theme. Drag or tap a straight line through each word.</p>
        <span class="card-cta" data-card-cta>Play today's wordsearch</span>
      </a>

      <a class="puzzle-card reveal" href="/sudoku" data-puzzle-card="sudoku">
        <div class="card-top">
          <span class="badge">Sudoku</span>
          <span class="card-status" data-card-status>Open</span>
        </div>
        <h2>Fill the 9×9</h2>
        <p>Classic medium sudoku. Same givens for everyone today. Notes and a keypad included.</p>
        <span class="card-cta" data-card-cta>Play today's sudoku</span>
      </a>

      <a class="puzzle-card reveal" href="/wordguess" data-puzzle-card="wordguess">
        <div class="card-top">
          <span class="badge">WordGuess</span>
          <span class="card-status" data-card-status>Open</span>
        </div>
        <h2>Three words, twelve guesses</h2>
        <p>Find three five-letter words in twelve shared turns. Closest board sits next to the keys.</p>
        <span class="card-cta" data-card-cta>Play today's WordGuess</span>
      </a>
    </div>
  </section>

  <section class="section reveal">
    <div class="how-blurb panel">
      <p class="panel-kicker">Same puzzle, every visitor</p>
      <h2>Generated from the date, not a server</h2>
      <p>
        All three boards are built in your browser from today's UTC date. There is no account and no live scoreboard — just the day's puzzles, and a streak if you come back tomorrow.
      </p>
      <a class="text-link" href="/how-it-works">How it works →</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHome } from "../client/home";
  initHome();
</script>
