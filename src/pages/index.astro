---
import BaseLayout from "../layouts/BaseLayout.astro";
import HubTile from "../components/HubTile.astro";
import { funnelLabels, funnelOrder } from "../data/types";
import {
  comingSoonHubs,
  fastRoiHireOrder,
  hubsByFunnel,
  logicalHireOrder,
  product,
  recommendedNextHubs,
  statSources,
  getHubById,
} from "../data/hubs";
---

<BaseLayout title={product.name} path="/">
  <section class="hero">
    <div class="hero-kicker">Local service operating system</div>
    <h1>
      Operate <em>IQ</em>
    </h1>
    <p class="hero-lead">{product.positioning}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/dashboard">Open owner leak score</a>
      <a class="btn btn-ghost" href="#interest">Join Hub 01 waitlist</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Leak map — 13 hubs</h2>
        <p>
          Each hub is an AI {product.naming.role.toLowerCase()} that plugs one named revenue leak.
          Hubs 01–05 ship first; add-ons show how the OS expands.
        </p>
      </div>
    </div>
    {
      funnelOrder.map((stage) => {
        const stageHubs = hubsByFunnel(stage);
        if (!stageHubs.length) return null;
        return (
          <div class="funnel-block">
            <h3>{funnelLabels[stage]}</h3>
            <div class="hub-grid">
              {stageHubs.map((hub) => (
                <HubTile hub={hub} />
              ))}
            </div>
          </div>
        );
      })
    }
  </section>

  <section class="section" id="hire-order">
    <div class="section-head">
      <div>
        <h2>Two hire paths</h2>
        <p>
          Logical operating order follows the funnel. Fastest ROI order leads with Database
          Reactivation when the CRM is already full of dust.
        </p>
      </div>
    </div>
    <div class="order-grid">
      <div class="panel">
        <span class="badge">Logical funnel</span>
        <h3 style="font-family: var(--font-display); margin: 0.75rem 0">
          Capture → Protect → Reactivate → Reputation → Convert → Insight
        </h3>
        <ol class="order-list">
          {
            logicalHireOrder.map((hub, index) => (
              <li>
                <span class="order-num">{index + 1}</span>
                <div>
                  <strong>
                    Hub {hub.number} · {hub.titleLead} {hub.titleAccent}
                  </strong>
                  <div class="meta-row" style="margin-top: 0.35rem">
                    <span class="chip">{hub.funnelStage}</span>
                    <span class="chip">{hub.operator}</span>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="panel">
        <span class="badge amber">Fastest ROI</span>
        <h3 style="font-family: var(--font-display); margin: 0.75rem 0">
          Cash-first when the database is full
        </h3>
        <ol class="order-list">
          {
            fastRoiHireOrder.map((hub, index) => (
              <li>
                <span class="order-num">{index + 1}</span>
                <div>
                  <strong>
                    Hub {hub.number} · {hub.titleLead} {hub.titleAccent}
                  </strong>
                  <div class="meta-row" style="margin-top: 0.35rem">
                    <span class="chip">ROI path #{hub.hireOrderFastRoi}</span>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>How add-ons sit on the core five</h2>
        <p>Supplement relationships — what each coming-soon hub extends.</p>
      </div>
    </div>
    <div class="os-map">{`04/03 capture ──► 08 omnichannel inbox
       │
       ├──► 06 no-show recovery
       └──► 07 quote follow-up ──► 05 sales coaching ──► 13 staff onboarding

01 dusty leads (never converted)
09 churned customers (were paying)     both feed revenue without ads
12 collections (after the sale)

02 ask for reviews/referrals
10 defend/reply to reputation damage

11 owner brief  ◄── scores all of the above`}</div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Add-on hubs (06–13)</h2>
        <p>
          Recommended next three to flesh after core five:{" "}
          {
            recommendedNextHubs
              .map((id) => {
                const h = getHubById(id);
                return h ? `Hub ${h.number}` : id;
              })
              .join(", ")
          }
        </p>
      </div>
    </div>
    <div class="hub-grid">
      {comingSoonHubs.map((hub) => (
        <HubTile hub={hub} />
      ))}
    </div>
  </section>

  <section class="section" id="interest">
    <div class="section-head">
      <div>
        <h2>Start with Hub 01</h2>
        <p>
          Database Reactivation is the fastest-ROI first hire when your CRM is already full.
          Leave your details — we’ll open pilot slots as the Outreach Operator hardens.
        </p>
      </div>
    </div>
    <div class="panel waitlist-panel">
      <form class="waitlist-form" id="waitlist-form" novalidate>
        <div class="waitlist-grid">
          <label>
            <span>Work email</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@business.com" />
          </label>
          <label>
            <span>Business name</span>
            <input type="text" name="businessName" autocomplete="organization" placeholder="River City Gym" />
          </label>
          <label>
            <span>Vertical</span>
            <select name="vertical">
              <option value="general">General SMB</option>
              <option value="gym">Gym</option>
              <option value="clinic">Clinic</option>
              <option value="home-services">Home services</option>
              <option value="salon">Salon</option>
            </select>
          </label>
          <input type="hidden" name="hubInterest" value="hub-01" />
        </div>
        <label class="waitlist-notes">
          <span>What’s leaking? (optional)</span>
          <textarea name="notes" rows="3" placeholder="Old leads never get a second touch…"></textarea>
        </label>
        <div class="waitlist-actions">
          <button class="btn btn-primary" type="submit">Join the Hub 01 waitlist</button>
          <p class="waitlist-status" id="waitlist-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Stat discipline</h2>
        <p>
          Headline numbers are treated as citeable claims — not decoration. Replace placeholders
          with the latest published survey year before public launch.
        </p>
      </div>
    </div>
    <div class="panel">
      <ul class="sources">
        {
          statSources.map((s) => (
            <li>
              <strong>{s.claim}</strong>
              <br />
              Source: {s.source}
              {
                s.note && (
                  <>
                    <br />
                    Note: {s.note}
                  </>
                )
              }
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("waitlist-form");
  const statusEl = document.getElementById("waitlist-status");
  if (form && statusEl) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      statusEl.textContent = "Sending…";
      statusEl.dataset.state = "pending";
      const data = new FormData(form);
      const payload = {
        email: String(data.get("email") || ""),
        businessName: String(data.get("businessName") || ""),
        vertical: String(data.get("vertical") || "general"),
        hubInterest: String(data.get("hubInterest") || "hub-01"),
        notes: String(data.get("notes") || ""),
      };
      try {
        const res = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (!res.ok || !json.ok) {
          throw new Error(json.error || "request_failed");
        }
        statusEl.textContent = "You’re on the list. We’ll reach out when Hub 01 pilots open.";
        statusEl.dataset.state = "ok";
        form.reset();
      } catch {
        statusEl.textContent = "Couldn’t submit right now. Email us or try again shortly.";
        statusEl.dataset.state = "err";
      }
    });
  }
</script>
