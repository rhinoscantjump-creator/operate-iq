---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Daily wordsearch"
  description="Today's Operate IQ wordsearch — the same 12×12 grid for everyone on this UTC day."
  path="/wordsearch"
  play
>
  <button
    type="button"
    class="play-pull"
    id="play-pull"
    aria-expanded="false"
    aria-controls="play-header-details"
  >
    <span class="play-pull-handle" aria-hidden="true"></span>
    <span class="play-pull-row">
      <span class="play-pull-label">Wordsearch</span>
      <span class="play-pull-date" id="play-date">Today</span>
      <span class="play-pull-action">Details</span>
    </span>
  </button>

  <section class="play-hero" id="play-header-details">
    <div class="hero-kicker">Daily puzzle</div>
    <h1>Daily <em>wordsearch</em></h1>
    <p class="play-sub">
      Theme: <strong id="ws-theme">…</strong>
      · <span id="ws-found-count">0 / 0</span> found
    </p>
  </section>

  <div id="ws-complete" class="complete-banner" hidden>
    <strong>Grid complete.</strong> Tomorrow's theme lands at midnight UTC.
  </div>

  <div class="play-layout">
    <div class="ws-stage">
      <div class="ws-mode-bar">
        <div class="ws-modes" role="radiogroup" aria-label="Board gestures">
          <button type="button" id="ws-mode-play" class="is-active" aria-checked="true" role="radio" data-ws-mode="play">
            Play
          </button>
          <button type="button" id="ws-mode-move" aria-checked="false" role="radio" data-ws-mode="move">Move</button>
        </div>
        <p class="ws-zoom-hint">Pinch to zoom. Two fingers slide the grid.</p>
      </div>
      <div class="ws-viewport" id="ws-viewport">
        <div id="ws-board" class="ws-board" role="grid" aria-label="Wordsearch grid"></div>
      </div>
    </div>
    <aside class="play-aside">
      <h2>Words</h2>
      <ul id="ws-words" class="word-list"></ul>
      <p class="play-hint">In Play, drag a straight line through a word — including diagonals and backwards.</p>
      <a class="btn btn-ghost" href="/">Back to today</a>
    </aside>
  </div>
</BaseLayout>

<script>
  import { initPlayChrome } from "../client/play-chrome";
  import { initWordsearch } from "../client/wordsearch";
  initPlayChrome();
  initWordsearch();
</script>
